<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The only two keys. The app reads and writes a Replica, and the Taskrc
	     paired with it, only through folders and files the user picks, kept
	     across launches as security-scoped bookmarks. It talks to nothing:
	     no network client, no Apple Events. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
